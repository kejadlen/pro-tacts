# The nokogiri surface pro-tacts uses to read REPORT bodies: parse, drop
# the namespaces, and pull elements out by xpath. And to write the DAV
# bodies and the profile, through a Builder whose elements are
# method_missing calls: DavXml::Namespace#tag makes its own with send,
# and the plist elements Profile calls directly are declared below.
#
# `root` is declared non-nil because Nokogiri::XML only returns a
# document without one for input that is not XML at all, and web.rb
# raises on that case explicitly rather than reading a nil root.
module Nokogiri
  def self.XML: (String string_or_io) -> Nokogiri::XML::Document

  module XML
    class Node
      def name: () -> String
      def text: () -> String
      def xpath: (String) -> NodeSet
    end

    class Document < Node
      def root: () -> Node?
      def remove_namespaces!: () -> Document
      def create_internal_subset: (String name, String external_id, String system_id) -> untyped
    end

    class NodeSet
      include Enumerable[Node]

      def each: () { (Node) -> void } -> void
    end

    class Builder
      def self.new: (?encoding: String) { (Builder) -> void } -> Builder
      def []: (String prefix) -> Builder
      def doc: () -> Document
      def to_xml: () -> String

      def plist: (version: String) { () -> void } -> void
      def dict: () { () -> void } -> void
      def array: () { () -> void } -> void
      def key: (String text) -> void
      def string: (String text) -> void
      def integer: (Integer value) -> void
      def `true`: () -> void
      def `false`: () -> void
    end
  end
end
