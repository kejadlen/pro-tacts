# Roda ships no signatures. This is the routing surface web.rb uses and
# no more of it: the class methods that build the app, the request
# methods that match and halt, and the response setters and writer.
#
# Matchers stay untyped on purpose. Roda's matcher vocabulary — strings,
# classes, regexps, symbols, hashes, and arrays of those — is open, and
# the block arguments a match yields depend on which matcher matched.
class Roda
  # The configure blocks vary by plugin — error_handler passes the
  # exception, not_found and the routes pass nothing — so the block
  # takes anything, like the matchers below. typecast_params' block
  # is the one run elsewhere: class_eval'd on the app's Params class,
  # where it registers conversion types.
  def self.plugin: (:typecast_params plugin) { () [self: singleton(RodaPlugins::TypecastParams::Params)] -> void } -> void
                 | (Symbol | Module plugin, *untyped args, **untyped options) ?{ (*untyped) [self: instance] -> untyped } -> void

  def self.use: (untyped middleware, **untyped options) -> void

  # App-level configuration, which is where web.rb keeps the store handed
  # to it. Frozen along with the app, so a write after that raises.
  def self.opts: () -> Hash[Symbol, untyped]

  # The block is the router, run against a fresh instance per request.
  def self.route: () { (RodaRequest) [self: instance] -> untyped } -> void

  # The hash_branches plugin's: a routing block for one next segment,
  # compiled into a method on the app and run against the same instance
  # the route block is, so it sees what the route set before it.
  def self.hash_branch: (String segment) { (RodaRequest) [self: instance] -> untyped } -> void
                      | (String | Symbol namespace, String segment) { (RodaRequest) [self: instance] -> untyped } -> void

  # The sec_fetch_site_csrf plugin's: halts a write whose
  # Sec-Fetch-Site the plugin was not configured to allow.
  def check_sec_fetch_site!: () -> void

  # The typecast_params plugin's: the request's params behind
  # conversion methods that raise TypecastParams::Error for a value of
  # the wrong shape. Untyped like the params themselves: a conversion
  # method's answer depends on the type it names.
  def typecast_params: () -> untyped

  def request: () -> RodaRequest
  def response: () -> RodaResponse

  class RodaRequest
    def env: () -> Rack::env
    def body: () -> Rack::_Input

    def is: (*untyped matchers) { (*untyped) -> untyped } -> void
    def on: (*untyped matchers) { (*untyped) -> untyped } -> void
    def delete: (*untyped matchers) ?{ (*untyped) -> untyped } -> void
    def get: (*untyped matchers) ?{ (*untyped) -> untyped } -> void
    def options: (*untyped matchers) ?{ (*untyped) -> untyped } -> void
    def post: (*untyped matchers) ?{ (*untyped) -> untyped } -> void
    def put: (*untyped matchers) ?{ (*untyped) -> untyped } -> void

    # The :public plugin's file server: answers a GET that names a file
    # under PUBLIC_ROOT from there, and falls through to the routes
    # below when it does not.
    def public: () -> void

    # The media type of the request body, without parameters — inherited
    # from Rack::Request in the gem, restated here because the local
    # RodaRequest does not.
    def media_type: () -> String?

    # The host the request named, without any port, inherited from
    # Rack::Request for the same reason as #media_type. The setup route
    # provisions an account for it (see web/setup.rb).
    def host: () -> String

    # The request's query and form parameters, inherited from
    # Rack::Request in the gem and restated here for the same reason as
    # #media_type. Values stay untyped: repeated keys arrive as arrays.
    def params: () -> Hash[String, untyped]

    # Halts the request, so nothing after it in a route block runs.
    def redirect: (String path, ?Integer status) -> bot

    # Ends the request with the response as it stands.
    def halt: () -> bot

    # Dispatches to the hash_branch for the next segment, if one is
    # defined, and ends the request with its answer.
    def hash_branches: (?String | Symbol namespace) -> void
  end

  class RodaResponse
    def []=: (String header, String value) -> void
    def status=: (Integer status) -> void
    def write: (String body) -> void
  end

  class RodaError < StandardError
  end

  module RodaPlugins
    def self.register_plugin: (Symbol name, Module plugin) -> void

    module TypecastParams
      # A submitted value in a shape the conversion refuses; the
      # error handler answers it as a 400.
      class Error < RodaError
        def param_name: () -> String?
      end

      class Params
        # A conversion type: `name` and `name!` methods that run the
        # block over a submitted value, a raise in it being an Error.
        def self.handle_type: (Symbol type) { (untyped value) -> untyped } -> void
      end
    end
  end
end
