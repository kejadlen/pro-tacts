# Sentry is reached wherever a handler has something to report: the
# exception-capturing middleware web.rb mounts, the refusal warnings
# RefusalAlerts sends, the arrival messages dav.rb and store.rb send,
# and the photo decode refusal contact.rb captures. ExchangeLog tags the
# request's scope and reads whether anything was reported under it, and
# the search times its steps as spans.
module Sentry
  # Yields nil outside a transaction, as under a nil DSN.
  def self.with_child_span: [T] (op: String, description: String) { (Span?) -> T } -> T

  class Span
    def set_data: (String key, Integer value) -> void
  end

  def self.capture_message: (String message, ?level: Symbol, ?fingerprint: Array[String], ?tags: Hash[Symbol, String]) -> untyped

  def self.capture_exception: (Exception exception, ?level: Symbol) -> untyped

  def self.set_tags: (**String tags) -> void

  def self.last_event_id: () -> String?

  module Rack
    class CaptureExceptions
    end
  end
end
