# Sentry is reached wherever a handler has something to report: the
# exception-capturing middleware web.rb mounts, the 404 and arrival
# messages web.rb and store.rb send, and the photo decode refusal
# contact.rb captures.
#
# Events are left untyped. SentryScrubber walks whatever before_send
# hands it, feature-detecting as it goes, and typing that shape would
# claim more about the sentry-ruby internals than the scrubber assumes.
module Sentry
  def self.capture_message: (String message, ?level: Symbol) -> untyped

  def self.capture_exception: (Exception exception, ?level: Symbol) -> untyped

  module Rack
    class CaptureExceptions
    end
  end
end
