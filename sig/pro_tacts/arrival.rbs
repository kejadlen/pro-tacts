# Lent and GroupEdit are Data classes, whose members the inline parser
# cannot read (see sig/pro_tacts/contact.rbs). Arrival itself is an
# ordinary class and its types are inline in arrival.rb.
module ProTacts
  class Arrival
    class Lent
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader line: String

      def self.new: (group_id: String, position: Integer, line: String) -> instance
    end

    class GroupEdit
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader line: String?

      def self.new: (group_id: String, position: Integer, line: String?) -> instance
    end
  end
end
