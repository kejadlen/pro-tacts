# Change is a Data class, whose members the inline parser cannot read
# (see sig/pro_tacts/contact.rbs). Store itself is an ordinary class and
# its types are inline in store.rb.
module ProTacts
  class Store
    class Change
      attr_reader sequence: Integer
      attr_reader card_id: String
      attr_reader action: String
      attr_reader etag: String?
      attr_reader diff: CardDiff
      attr_reader created_at: String

      def self.new: (sequence: Integer, card_id: String, action: String, etag: String?, diff: CardDiff, created_at: String) -> instance
    end

    class RecentContact
      attr_reader contact: Contact
      attr_reader updated_at: String

      def self.new: (contact: Contact, updated_at: String) -> instance
    end

    class UpcomingBirthday
      attr_reader contact: Contact
      attr_reader occurs_on: Date

      def self.new: (contact: Contact, occurs_on: Date) -> instance
    end

    class Lent
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader label: String
      attr_reader line: String

      def self.new: (group_id: String, position: Integer, label: String, line: String) -> instance
    end

    class GroupEdit
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader line: String?

      def self.new: (group_id: String, position: Integer, line: String?) -> instance
    end
  end
end
