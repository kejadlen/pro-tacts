# Import::Vcf::Unknown is a Data class, whose members the inline parser
# cannot read (see sig/pro_tacts/contact.rbs). It is marked `@rbs skip`
# where it is defined and signed here.
module ProTacts
  module Import
    module Vcf
      class Unknown
        attr_reader name: String
        attr_reader count: Integer
        attr_reader examples: Array[String]

        def self.new: (name: String, count: Integer, examples: Array[String]) -> instance
      end
    end
  end
end
