# VCard is signed here rather than inline: its Enumerable include is
# generic, which the inline parser refuses (the rule
# docs/plans/2026-08-20-type-checking.md records). Property and Line
# are Data classes, which the inline syntax cannot read either.
module ProTacts
  class VCard
    include Enumerable[Line]

    LINE_LIMIT: Integer
    TEXT_ESCAPES: Hash[String, String]
    LINE_BREAK: Regexp
    FOLD: Regexp
    CONTINUATION: Regexp
    END_LINE: Regexp

    class ParseError < StandardError
    end

    def initialize: (String bytes) -> void

    def bytes: () -> String

    def properties: () -> Array[Property]?

    def parseable?: () -> bool

    def card?: () -> bool

    def uid: () -> String?

    def each: () { (Line) -> void } -> Array[Line]

    def insert: (Array[String] lines) -> String

    def self.escape: (String text) -> String

    def self.unescape: (String text) -> String

    def self.split_components: (String value) -> Array[String]

    def self.fold: (String line) -> String

    def self.unfold: (String card) -> String

    private

    def parse: (Array[String] group) -> Property?

    def lines: () -> Array[Line]

    def physical_lines: () -> Array[String]

    def line_groups: () -> Array[Array[String]]

    def terminator_of: (String line) -> String

    class Property
      attr_reader group: String?
      attr_reader name: String
      attr_reader parameters: Array[[String, String]]
      attr_reader value: String

      def self.new: (group: String?, name: String, parameters: Array[[String, String]], value: String) -> instance
    end

    class Line
      attr_reader property: Property?
      attr_reader verbatim: String

      def self.new: (property: Property?, verbatim: String) -> instance

      def names?: (String name) -> bool
    end
  end
end
