# Property and Line are Data classes, which the inline syntax cannot
# read — Data.define leaves them no constant super class — so their
# signatures live here. VCard itself is signed inline in vcard.rb.
module ProTacts
  class VCard
    class Property
      attr_reader group: String?
      attr_reader name: String
      attr_reader parameters: Array[[String, String]]
      attr_reader value: String

      def self.new: (group: String?, name: String, parameters: Array[[String, String]], value: String) -> instance
    end

    class Line
      attr_reader properties: Array[Property]
      attr_reader verbatim: String
      attr_reader error: ParseError?

      def self.new: (properties: Array[Property], verbatim: String, error: ParseError?) -> instance
    end
  end
end
