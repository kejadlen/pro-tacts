# lib/pro_tacts/admin is ignored by the Steepfile — built on Phlex,
# which ships no signatures — but web.rb still calls its views, and
# a checked file cannot reference a constant nothing declares. This
# holds exactly that entry surface; the views' own files carry none.
# When Phlex gets a stand-in under sig/gems and admin is checked for
# real, delete this.
module ProTacts
  module Admin
    class ContactsShow
      def self.call: (contact: Contact) -> String
    end

    class ContactsIndex
      def self.call: (recent: Array[Store::RecentContact], upcoming: Array[Store::UpcomingBirthday], query: String?) -> String
    end

    # Rendered by ContactsIndex, not called from checked code; only
    # its LIMIT is read in web.rb.
    class UpcomingBirthdays
      LIMIT: Integer
    end
  end
end
