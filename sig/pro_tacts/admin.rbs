# lib/pro_tacts/admin is ignored by the Steepfile — built on Phlex,
# which ships no signatures — but web.rb still calls its views, and
# a checked file cannot reference a constant nothing declares. This
# holds exactly that entry surface; the views' own files carry none.
# When Phlex gets a stand-in under sig/gems and admin is checked for
# real, delete this.
module ProTacts
  module Admin
    class ContactsShow
      def self.call: (contact: Contact, groups: Array[Store::Group], all_groups: Array[Store::GroupChoice], changes: Array[Store::Change], ?notice: String?) -> String
    end

    # `aside` is a Phlex component, which has no type here: phlex
    # ships no signatures and the views are ignored (see the
    # Steepfile).
    class ContactsEdit
      def self.call: (contact: Contact, ?notice: String?, ?action: String?, ?back: [String, String]?, ?aside: untyped, ?fields: untyped, ?lead: untyped, ?sidebar: untyped, ?save: String?) -> String
    end

    class Dashboard
      def self.call: (recent: Array[Store::RecentContact], upcoming: Array[Store::UpcomingBirthday], query: String?, groups: Array[Store::Group], ?notice: String?) -> String
    end

    class ContactsIndex
      def self.call: (contacts: Array[Contact], groups: Array[Store::Group]) -> String
    end

    class GroupsIndex
      def self.call: (groups: Array[Store::Group], ?notice: String?) -> String
    end

    class GroupsShow
      def self.call: (group: Store::Group, members: Array[Contact]) -> String
    end

    class GroupsEdit
      def self.call: (group: Store::Group, ?notice: String?) -> String
    end

    class DeviceSetup
      def self.call: (hostname: String, name: String) -> String
    end

    class ImportUpload
      def self.call: (?notice: String?) -> String
    end

    # Rendered into ContactsEdit rather than called, so these are the
    # views here whose `new` is what checked code reaches for.
    class ImportOriginal
      def self.new: (card: ::ProTacts::VCard, dropped: Array[::ProTacts::VCard::Parser::Line]) -> instance
    end

    class ImportGroups
      def self.new: (groups: Array[::ProTacts::Store::GroupChoice], joined: Array[String], named: Array[String], ?was: Array[String]) -> instance
    end

    class ImportTarget
      def self.new: (row: String, matches: Array[Contact], into: Contact?) -> instance
    end

    class ImportSidebar
      def self.new: (upload: String, rows: Array[[Contact, Integer]], saved: Hash[String, String], current: Integer) -> instance
    end

    class ImportSaved
      def self.call: (contact: Contact, groups: Array[Store::Group], all_groups: Array[Store::GroupChoice], aside: untyped, sidebar: untyped, edit: String, land: String, ?notice: String?) -> String
    end

    # Rendered by Dashboard, not called from checked code; only
    # its LIMIT is read in web.rb.
    class UpcomingBirthdays
      LIMIT: Integer
    end
  end
end
