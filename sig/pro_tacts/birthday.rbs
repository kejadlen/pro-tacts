# Birthday is a Data class, whose members the inline parser cannot
# read (see sig/pro_tacts/contact.rbs). It is marked `@rbs skip` in
# birthday.rb and signed here instead.
module ProTacts
  class Birthday
    FULL_DATE: Regexp
    OMIT_YEAR_DATE: Regexp
    OMIT_YEAR: String
    YEAR_AND_MONTH: Regexp
    YEAR_ALONE: Regexp
    MONTH_ALONE: Regexp
    DAY_ALONE: Regexp
    UNRENDERED_VALUES: Array[Regexp]
    REDUCED_DATE: Regexp

    attr_reader year: Integer?
    attr_reader month: Integer?
    attr_reader day: Integer?

    def self.new: (?year: Integer?, ?month: Integer?, ?day: Integer?) -> instance

    def to_line: () -> String?

    def to_s: () -> String

    def served?: () -> bool

    def self.from_value: (String value) -> Birthday?

    def self.from_property: (VCard::Parser::Property property) -> Birthday?

    def self.apple_no_year?: (VCard::Parser::Property property) -> bool

    def self.unrendered_value?: (String value) -> bool

    def self.rendered?: (VCard::Parser::Property property) -> bool
  end
end
