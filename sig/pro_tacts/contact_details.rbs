# ContactDetails' Data classes, whose members the inline parser cannot
# read: Data.define leaves them no constant super class. Each is marked
# `@rbs skip` in contact_details.rb and signed here; ContactDetails
# itself is a plain class and carries its signature inline, as does
# ContactReadings.
module ProTacts
  class ContactDetails
    # The repeatable rows' classes, which the editor walks alike
    # (Admin::CardForm.edited_rows). An alias the inline syntax has no
    # spelling for.
    type row_class = singleton(Phone) | singleton(Email) | singleton(Handle)

    class Phone
      attr_reader value: String
      attr_reader label_line: VCard::Parser::Line?
      attr_reader types: Array[String]
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property

      def self.new: (value: String, label_line: VCard::Parser::Line?, types: Array[String], line: VCard::Parser::Line, property: VCard::Parser::Property) -> instance
    end

    class Email
      attr_reader value: String
      attr_reader label_line: VCard::Parser::Line?
      attr_reader types: Array[String]
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property

      def self.new: (value: String, label_line: VCard::Parser::Line?, types: Array[String], line: VCard::Parser::Line, property: VCard::Parser::Property) -> instance
    end

    class Handle
      attr_reader service: String?
      attr_reader value: String
      attr_reader scheme: String
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property

      def self.new: (service: String?, value: String, scheme: String, line: VCard::Parser::Line, property: VCard::Parser::Property) -> instance
    end

    class Photo
      attr_reader mime_type: String
      attr_reader bytes: String

      def self.new: (mime_type: String, bytes: String) -> instance
    end

    class Address
      attr_reader po_box: String
      attr_reader extended: String
      attr_reader street: String
      attr_reader locality: String
      attr_reader region: String
      attr_reader postal_code: String
      attr_reader country: String
      attr_reader label: String?
      attr_reader lent_by: Group?

      def self.new: (po_box: String, extended: String, street: String, locality: String, region: String, postal_code: String, country: String, ?label: String?, ?lent_by: Group?) -> instance
    end

    class LentAddress
      attr_reader position: Integer
      attr_reader address: Address

      def self.new: (position: Integer, address: Address) -> instance
    end

    class Lent
      attr_reader group: Group
      attr_reader addresses: Array[LentAddress]
      attr_reader note: String?

      def self.new: (group: Group, addresses: Array[LentAddress], note: String?) -> instance
    end
  end
end
