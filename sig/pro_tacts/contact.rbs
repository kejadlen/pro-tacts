# Contact::Phone, ::Email, ::Handle, ::Note, ::Inherited, ::Photo,
# and ::Address are Data classes, whose members the inline parser cannot read: Data.define
# leaves them no constant super class. Each is marked `@rbs skip` in
# contact.rb and signed here; Contact itself is a plain class and
# carries its signature inline.
module ProTacts
  class Contact
    # The repeatable rows' classes, which the editor walks alike
    # (Admin::CardForm.edited_rows). An alias the inline syntax has no
    # spelling for.
    type row_class = singleton(Phone) | singleton(Email) | singleton(Handle) | singleton(Address)

    class Phone
      attr_reader value: String
      attr_reader label_line: VCard::Parser::Line?
      attr_reader types: Array[String]
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property
      attr_reader lent_by: Group?

      def self.new: (value: String, label_line: VCard::Parser::Line?, types: Array[String], line: VCard::Parser::Line, property: VCard::Parser::Property, lent_by: Group?) -> instance
    end

    class Email
      attr_reader value: String
      attr_reader label_line: VCard::Parser::Line?
      attr_reader types: Array[String]
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property
      attr_reader lent_by: Group?

      def self.new: (value: String, label_line: VCard::Parser::Line?, types: Array[String], line: VCard::Parser::Line, property: VCard::Parser::Property, lent_by: Group?) -> instance
    end

    class Handle
      attr_reader service: String?
      attr_reader value: String
      attr_reader scheme: String
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property
      attr_reader lent_by: Group?

      def self.new: (service: String?, value: String, scheme: String, line: VCard::Parser::Line, property: VCard::Parser::Property, lent_by: Group?) -> instance
    end

    class Note
      attr_reader value: String
      attr_reader line: VCard::Parser::Line

      def self.new: (value: String, line: VCard::Parser::Line) -> instance
    end

    class Inherited
      attr_reader group: Group
      attr_reader position: Integer
      attr_reader line: String

      def self.new: (group: Group, position: Integer, line: String) -> instance
    end

    class Photo
      attr_reader mime_type: String
      attr_reader bytes: String

      def self.new: (mime_type: String, bytes: String) -> instance
    end

    class Address
      attr_reader po_box: String?
      attr_reader extended: String?
      attr_reader street: String?
      attr_reader locality: String?
      attr_reader region: String?
      attr_reader postal_code: String?
      attr_reader country: String?
      attr_reader types: Array[String]
      attr_reader label_line: VCard::Parser::Line?
      attr_reader line: VCard::Parser::Line
      attr_reader property: VCard::Parser::Property
      attr_reader lent_by: Group?

      def self.new: (
        po_box: String?,
        extended: String?,
        street: String?,
        locality: String?,
        region: String?,
        postal_code: String?,
        country: String?,
        types: Array[String],
        label_line: VCard::Parser::Line?,
        line: VCard::Parser::Line,
        property: VCard::Parser::Property,
        lent_by: Group?
      ) -> instance
    end
  end
end
