# EditedContact::GroupEdit is a Data class, whose members the inline
# parser cannot read (see sig/pro_tacts/contact.rbs). EditedContact
# itself is an ordinary class and its types are inline in
# edited_contact.rb.
module ProTacts
  class EditedContact
    class GroupEdit
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader line: String?

      def self.new: (group_id: String, position: Integer, line: String?) -> instance
    end
  end
end
