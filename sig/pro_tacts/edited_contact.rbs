# EditedContact::AddressEdit, ::NoteEdit, and ::Decomposed are Data
# classes, whose members the inline parser cannot read (see
# sig/pro_tacts/contact.rbs). EditedContact itself is an ordinary class
# and its types are inline in edited_contact.rb.
module ProTacts
  class EditedContact
    class AddressEdit
      attr_reader group_id: String
      attr_reader position: Integer
      attr_reader address: Contact::Address?

      def self.new: (group_id: String, position: Integer, address: Contact::Address?) -> instance
    end

    class NoteEdit
      attr_reader group_id: String
      attr_reader text: String?

      def self.new: (group_id: String, text: String?) -> instance
    end

    class Decomposed
      attr_reader stored: VCard
      attr_reader birthday: Birthday?
      attr_reader addresses: Array[Contact::Address]
      attr_reader note: String?
      attr_reader address_edits: Array[AddressEdit]
      attr_reader note_edits: Array[NoteEdit]

      def self.new: (
        stored: VCard,
        birthday: Birthday?,
        addresses: Array[Contact::Address],
        note: String?,
        address_edits: Array[AddressEdit],
        note_edits: Array[NoteEdit]
      ) -> instance
    end
  end
end
